{
    "version": 2,
    "builds": [
        {
            "src": "api/index.js",
            "use": "@vercel/node"
        }
    ],
    "rewrites": [
        {
            "source": "/privacy",
            "destination": "/api"
        },
        {
            "source": "/terms",
            "destination": "/api"
        },
        {
            "source": "/download",
            "destination": "/api"
        },
        {
            "source": "/api/(.*)",
            "destination": "/api"
        }
    ]
}